{
  "expo": {
    "name": "Allô Joy",
    "slug": "allo-joy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "allojoy",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "gn.allojoy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pour trouver les prestataires proches de vous.",
        "NSLocationAlwaysUsageDescription": "Pour recevoir des mises à jour de votre mission en cours."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "gn.allojoy.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pour trouver les prestataires proches de vous."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0ea5e9",
          "sounds": []
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "ios": {},
          "android": {}
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "allo-joy-project-id"
      },
      "apiUrl": "https://api.allojoy.gn"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/allo-joy-project-id"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
