# Copier ce fichier : cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars est gitignored — ne jamais committer les valeurs réelles

# ── Obligatoires ──────────────────────────────────────────────────────────────
db_password            = "remplacer-par-un-mot-de-passe-fort-32-chars"
jwt_secret             = "remplacer-par-un-secret-aleatoire-256-bits-min"
africastalking_api_key = "votre-cle-africastalking"
africastalking_username = "sandbox"   # "allojoy" en production

